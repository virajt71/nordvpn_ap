# NordVPN Credentials (for OpenVPN)
OPENVPN_USER=your_nordvpn_service_user
OPENVPN_PASSWORD=your_nordvpn_service_password

# WireGuard Credentials (for NordLynx)
# To get this, generate a token from NordVPN dashboard and run the curl command in README
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key

# Shared VPN Settings
SERVER_COUNTRIES=India
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24 # Change this to your host's local LAN subnet
