# Instance identifier — must be unique per tunnel (vpn0, vpn1, vpn2...)
INSTANCE=vpn0

# Routing table ID — must be unique per instance (100, 101, 102...)
ROUTING_TABLE=100

# VPN
VPN_TYPE=wireguard
OPENVPN_USER=
OPENVPN_PASSWORD=
WIREGUARD_PRIVATE_KEY=

# Server selection
SERVER_COUNTRIES=
SERVER_CITIES=

# Kill-switch: allow host LAN through gluetun firewall
FIREWALL_OUTBOUND_SUBNETS=192.168.50.10/32

# Access Point — AP_IFACE must be a physical adapter not used by another instance
AP_IFACE=wlan0
AP_SSID=ap_vpn0
AP_PASSWORD=
AP_CHANNEL=6
AP_HW_MODE=g
AP_CHANNEL_WIDTH=20
AP_IP=192.168.60.1
AP_SUBNET=192.168.60.0/24
AP_SECURITY=wpa2
